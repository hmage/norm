#!/bin/bash

needs_tool cmake

depends_on libsdl2 ## runtime and build-time SDL2 compatibility layer dependency

fetch_source https://github.com/libsdl-org/sdl12-compat/releases/download/release-1.2.78/sdl12-compat-1.2.78.tar.gz ff96106f3d21fb4692d0e562a8d0301ed94171af

do_unpack_compile -DSDL12TESTS=OFF

ln -sf sdl12_compat.pc "$PREFIX/lib/pkgconfig/sdl.pc"
