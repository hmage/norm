#!/bin/bash

fetch_source https://sourceforge.net/projects/exiftool/files/Image-ExifTool-13.64.tar.gz/download 8889ff75016e6161017cf0a4512a62fe55e620aa Image-ExifTool-13.64.tar.gz

do_unpack
pushd_src
perl Makefile.PL INSTALL_BASE="$PREFIX"
sed -i.bak \
    -e "s|^[[:space:]]*my .*incDir = .*$|    my \$incDir = \"$PREFIX/lib/perl5\";|" \
    -e "s|\$exeDir/lib|$PREFIX/lib/perl5|" \
    exiftool
make install
popd_src
