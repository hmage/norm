#!/bin/bash

fetch_source https://sourceforge.net/projects/exiftool/files/Image-ExifTool-13.61.tar.gz/download b3d4aff61a6b954c4ba9c30e17dde6773a7761e6 Image-ExifTool-13.61.tar.gz

do_unpack
pushd_src
perl Makefile.PL INSTALL_BASE="$PREFIX"
sed -i.bak \
    -e "s|^[[:space:]]*my .*incDir = .*$|    my \$incDir = \"$PREFIX/lib/perl5\";|" \
    -e "s|\$exeDir/lib|$PREFIX/lib/perl5|" \
    exiftool
make install
popd_src
