#!/bin/bash

fetch_source https://www.cl.cam.ac.uk/~mgk25/jbigkit/download/jbigkit-2.2.tar.gz 4fe5bfa95e557ae47c28e04397ff2ab6408dc10e

do_unpack
pushd_src
cd libjbig
## add -fPIC, otherwise it will fail to link with libtiff on x64 linux (relocation failure)
do_make CC=$CC CFLAGS="-g -O2 -fPIC" libjbig.a libjbig85.a tstcodec tstcodec85
do_test CC=$CC CFLAGS="-g -O2 -fPIC"
install -d $PREFIX/lib
install -m 644 *.a $PREFIX/lib
install -d $PREFIX/include
install -m 644 *.h $PREFIX/include
popd
