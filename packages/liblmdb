#!/bin/bash

## lmdb 1.0 changes the on-disk format and cannot read 0.9 databases, stay on 0.9.x
fetch_source https://git.openldap.org/openldap/openldap/-/archive/LMDB_0.9.37/openldap-LMDB_0.9.37.tar.gz 0e4f846f3d20aed549603285aee2c94f6c81b86d

FLAGS=(prefix="$PREFIX")
[[ $OSTYPE == *darwin* ]] && FLAGS+=(SOEXT=.dylib)

do_unpack
pushd_src
cd libraries/liblmdb
do_make "${FLAGS[@]}"
do_make install "${FLAGS[@]}"

## fix dylib install_name on macOS
if [[ $OSTYPE == *darwin* ]]; then
	install_name_tool -id "$PREFIX/lib/liblmdb.dylib" "$PREFIX/lib/liblmdb.dylib"
fi
popd_src
