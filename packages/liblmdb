#!/bin/bash

fetch_source https://github.com/LMDB/lmdb/archive/refs/tags/LMDB_0.9.36.tar.gz d89e60bb481938c90142541a77b70966d9cae836

FLAGS=(prefix="$PREFIX")
[[ $OSTYPE == *darwin* ]] && FLAGS+=(SOEXT=.dylib)

do_unpack
pushd_src
cd libraries/liblmdb
do_make "${FLAGS[@]}"
do_make install "${FLAGS[@]}"

## fix dylib install_name on macOS
if [[ $OSTYPE == *darwin* ]]; then
	install_name_tool -id "$PREFIX/lib/liblmdb.dylib" "$PREFIX/lib/liblmdb.dylib"
fi
popd_src
