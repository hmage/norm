#!/bin/bash

depends_on libgdbm ## opportunistic linking
depends_on libdb   ## opportunistic linking

fetch_source https://www.cpan.org/src/5.0/perl-5.45.5.tar.gz 8abebb882e08580b9a8c03eb85ce78c8bceda7fb

do_unpack
pushd_src
./Configure -des \
            -Dusedevel \
            -Dprefix=$PREFIX \
            -Dloclibpth="$PREFIX/lib" \
            -Accflags="$CPPFLAGS" \
            -Dusethreads
do_make
## a lot of stuff depends on perl, so it must pass all self checks
pushd_src
CI=true LC_ALL=C \
HARNESS_OPTIONS=j"$NUMJOBS" PERL_TEST_HARNESS_ASAP=1 \
make test_harness_notty
popd_src
do_install
popd
