#!/bin/bash

[[ $OSTYPE == *darwin* ]] && log "Building GCC on OSX fails at the moment" && false

depends_on libgmp
depends_on libmpfr
depends_on libmpc

CONFIGURE_OPTIONS=(
--program-suffix=-10.5    # version suffix to all binaries
--enable-__cxa_atexit    # for fully standards-compliant destructors, requires libc to have __cxa_atexit
--enable-languages=c,c++ # only C and C++, gcc is barely used for anything else
--enable-version-specific-runtime-libs # keep runtimes from different GCC versions separate
--disable-bootstrap      # never had bootstrap detect anything, speed up compilation
)

if ! test_cc_value "linux/fs.h" 'FS_IOC_GETFLAGS'; then
    CONFIGURE_OPTIONS+=(--disable-libsanitizer)
    add_caveat "Sanitizer support was disabled -- your linux headers are too old"
fi

if cc_checkflags -m64 && cc_checkflags -m32; then
    CONFIGURE_OPTIONS+=(--enable-multilib)
else
    CONFIGURE_OPTIONS+=(--disable-multilib)
    add_caveat "Multilib support was disabled -- your current compiler doesn't support multilib"
fi

fetch_source https://sourceware.org/pub/gcc/releases/gcc-10.5.0/gcc-10.5.0.tar.xz 87446e6e93cab52dea610a06e23c9653195abd21
do_unpack

# Use lib rather than lib64 on 64-bit Linux.
[[ $HOSTTYPE == "x86_64" ]] && sed -ibak '/m64=/s/lib64/lib/' "$SRCDIR"/gcc/config/i386/t-linux64

# Keep libgcc's multilibs inside the version directory as well.
sed -ibak '/^MULTIOSDIR :=/s/-print-multi-os-directory/-print-multi-directory/' "$SRCDIR"/libgcc/Makefile.in

do_compile_outside "${CONFIGURE_OPTIONS[@]}"

# Let programs find this compiler's separate runtime libraries.
gcc_libdir=$(dirname "$("$PREFIX/bin/gcc-10.5" -print-libgcc-file-name)")
gcc_multilibs=$("$PREFIX/bin/gcc-10.5" -print-multi-lib)
gcc_specs=$("$PREFIX/bin/gcc-10.5" -dumpspecs)
{
    printf '%s\n\n' "$gcc_specs"
    printf '*link:\n+ %%{!static:%%{!static-pie:'
    while IFS=';' read -r multilib flags; do
        printf ' -rpath %s' "$gcc_libdir/$multilib"
    done <<< "$gcc_multilibs"
    printf '}}\n\n'
} > "$gcc_libdir/specs"

add_to_ccache g++-10.5 gcc-10.5

add_caveat "To not clash with system-installed default gcc, GCC 10.5 was installed with a suffix, run gcc-10.5 or g++-10.5"

add_caveat "Remember -- you can't use this build of gcc on any other machine" \
           "Do not move it away from $PREFIX either -- paths are hardcoded"
