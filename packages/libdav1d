#!/bin/bash

depends_on meson
depends_on ninja
depends_on nasm

fetch_source https://code.videolan.org/videolan/dav1d/-/archive/1.5.5/dav1d-1.5.5.tar.bz2 8d71a3aa910f74c8d0c420b87b2e2191a51147ea

do_unpack
BUILDDIR="$SRCDIR"-build
rm -rf "$BUILDDIR"
mkdir -p "$BUILDDIR"
pushd "$BUILDDIR"
meson setup --prefix="$PREFIX" --buildtype=release "$SRCDIR"
ninja -j$NUMJOBS
ninja install
popd
