#!/bin/bash

depends_on zlib # for zlib.h
depends_on openssl

do_gitclone https://github.com/giltene/wrk2

pushd_src
## replace bundled LuaJIT with the maintained v2.1 branch
rm -rf deps/luajit
git clone --branch v2.1 https://luajit.org/git/luajit.git deps/luajit
sed -i.bak 's/struct luaL_reg/luaL_Reg/g' src/script.c
do_make CFLAGS="-std=gnu99 -O2 -g -Ideps/luajit/src $CPPFLAGS"
install -m755 wrk "$PREFIX/bin/wrk2"
popd_src
